# Grok Box configuration. Copy to config.env (gitignored) and edit:  cp config.env.example config.env
# No secrets belong in this file. It is sourced by bash, so keep valid bash syntax.
# GB_DIR (the repo directory) is set by lib.sh from the script location; the repo can live anywhere.

# --- layout (defaults are fine) ---------------------------------------------------------------
GB_BIN="${GB_BIN:-$GB_DIR/bin}"            # restic + rclone binaries (downloaded by install.sh)
GB_SECRETS="${GB_SECRETS:-$GB_DIR/secrets}" # restic-pass, rclone.conf, gdrive-oauth-client.json (chmod 700)
GB_STATE="${GB_STATE:-$GB_DIR/state}"       # locks, timestamps, ALERT marker, manifests
GB_LOGS="${GB_LOGS:-$GB_DIR/logs}"
GB_STAGING="${GB_STAGING:-$GB_DIR/staging}" # SQLite copies + brain export (backed up with the roots)
GB_CACHE="${GB_CACHE:-$GB_DIR/cache}"       # restic cache
export TZ=UTC                              # time zone for logs/status and scheduler slots, e.g. Europe/Berlin
export RESTIC_CACHE_DIR="$GB_CACHE"
export RCLONE_CONFIG="$GB_SECRETS/rclone.conf"
export RESTIC_PASSWORD_FILE="$GB_SECRETS/restic-pass"   # NEVER uploaded, always excluded

# --- destination ------------------------------------------------------------------------------
GB_REMOTE="${GB_REMOTE:-gdrive}"                 # rclone remote name (auth-gdrive.sh creates it)
GB_FOLDER="${GB_FOLDER:-GrokBox/restic}"         # folder in Drive that holds the restic repository
# Any restic repository works (e.g. a local path for tests). rclone options are only added for rclone: repos.
export RESTIC_REPOSITORY="rclone:$GB_REMOTE:$GB_FOLDER"
RCLONE_SERVE_ARGS="--drive-use-trash=false --tpslimit 8 --drive-chunk-size 64M"
# 1 = files deleted by forget/prune go to the Drive trash instead of being deleted at once, so a bad
# prune can be undone for ~30 days (Google empties the trash after that). Cost: pruned data keeps
# counting against the Drive quota until then. Normal backups (lock files etc.) still skip the trash.
# 0 = turn it off (PRUNE_USE_TRASH=0): forget/prune delete at once (no undo, no quota cost).
PRUNE_USE_TRASH=1

# --- time limits (a hung Drive call must never hold the backup lock forever) --------------------
# GNU timeout durations (e.g. 90m, 3h); 0 = no limit. A killed run exits 124/137 and raises an alert.
RESTIC_TIMEOUT=3h                # default for every restic call (snapshots, forget, tag, ls, ...)
RESTIC_TIMEOUT_BACKUP=12h        # restic backup (the very first upload of a big box can take hours;
                                 # a killed upload is resumed by the next run, uploaded data is reused)
RESTIC_TIMEOUT_CHECK=8h          # prune and check
RCLONE_TIMEOUT=300               # direct rclone calls (auth-gdrive.sh --test), seconds
PROMOTE_LOCK_WAIT=2m             # wait for the exclusive snapshot-promotion lock on each tag attempt
SNAPSHOT_LIST_RETRY_S=5          # seconds before retrying a failed backup snapshot listing once
LOCK_ALERT_HOURS=13              # minimum lock alert age; extended to the holder job timeout budget

# --- what to back up --------------------------------------------------------------------------
BACKUP_ROOTS=(/workspace /home/box)
BACKUP_HOST=grokbox              # fixed host name so snapshots line up across box moves
BACKUP_SECRETS=1                 # 1 = also back up credential files (repo is encrypted; restic-pass is ALWAYS left out)
BACKUP_PROFILE=full              # full | lean (lean also applies excludes-lean.txt, e.g. for a 15 GB Drive)
EXCLUDE_VENVS=0                  # 1 = skip Python venvs (dirs containing pyvenv.cfg)
EXCLUDE_CACHEDIRS=0              # 1 = skip dirs marked with CACHEDIR.TAG (e.g. model caches)
EXTRA_EXCLUDES=()                # extra restic exclude patterns, e.g. ("/workspace/scratch" "**/*.iso")
RESTORE_BASE=/workspace          # restore.sh / test-restore.sh write to $RESTORE_BASE/restore-* (always excluded)

# --- retention --------------------------------------------------------------------------------
# Hourly snapshots carry tag `auto`, 15-minute snapshots carry tag `quick`; each tag is forgotten
# with its own policy so quick snapshots never disturb the hourly/daily/weekly/monthly chain.
KEEP=(--keep-hourly 24 --keep-daily 30 --keep-weekly 12 --keep-monthly 12)
KEEP_QUICK=(--keep-within 24h)
QUICK_EVERY_MIN=15               # quick snapshot cadence in minutes; 0 disables
QUICK_ROOTS=("${BACKUP_ROOTS[@]}")

# --- schedule (scheduler.sh, times in $TZ) ----------------------------------------------------
HOURLY_AT_MIN=17                 # hourly snapshot from this minute of each hour
DAILY_CHECK_AT="04:40"           # daily forget + prune + check (HH:MM)
WATCHDOG_AT_MIN=50               # hourly watchdog slot
ALERT_NO_SUCCESS_HOURS=3         # alert when no successful hourly snapshot for this long (or since the scheduler first started)
FIRST_SUCCESS_GRACE_HOURS=2      # status.sh flags ATTENTION when there is still no successful hourly snapshot this long after install
HEARTBEAT_MAX_MIN=90             # status.sh flags the scheduler as hung when its loop heartbeat (state/scheduler.heartbeat)
                                 # is older than this without its own verified live job
RESTORE_LOCK_WAIT=600            # restore.sh waits up to this long (seconds) for backup.lock before giving up (exit 8)

# --- capacity + logs (nightly check.sh) --------------------------------------------------------
QUOTA_ALERT_PCT=90               # alert when the local disk or the Drive quota is this % full or more
LOG_RETENTION_DAYS=0             # 0/unset = keep logs forever; N = delete logs/backup-*.log older than ~N days
                                 # (alerts.log is never deleted)

# --- stale-computer guard ---------------------------------------------------------------------
GUARD_MAX_DROP_PCT=20            # abort if file count or bytes drop more than this vs the last good hourly run
GUARD_MTIME_BACK_HOURS=6         # abort if the newest file is this much older than the last good run's newest
GUARD_MIN_UPTIME_MIN=15          # skip runs right after boot (box hydration may still be copying files in)

# --- hydration guard --------------------------------------------------------------------------
# Some platforms write a log while they copy files back onto a freshly moved box. If this file
# exists and does NOT contain the pattern, backups are skipped (they would record a half-empty box).
# Set HYDRATION_LOG="" to disable.
HYDRATION_LOG=/tmp/sand-copy-in.log
HYDRATION_OK_PATTERN='outcome=hydrated'

# --- consistent SQLite copies -----------------------------------------------------------------
# Live databases cannot be copied safely as plain files. Matching files that are real SQLite
# databases are copied with SQLite's online-backup API into $GB_STAGING/sqlite/<original path>.
# Their live originals (+ -wal/-shm) under the roots are excluded when SQLITE_EXCLUDE_LIVE=1.
SQLITE_GLOBS=(
  '/home/box/agent-data/**/*.db' '/home/box/agent-data/**/*.sqlite'
  '/home/box/sand-data/**/*.db' '/home/box/sand-data/**/*.sqlite'
  '/cursor/stores/**/*.db' '/cursor/stores/**/*.sqlite'
)
SQLITE_EXCLUDE_LIVE=1

# --- brain export -----------------------------------------------------------------------------
# Discovers agent data directories and mounted agent stores, writes $GB_STAGING/brain/INDEX.md and
# copies stores that live OUTSIDE the backup roots (otherwise restic would never see them).
BRAIN_AGENT_DIRS=(/home/box/agent-data /home/box/sand-data)
STORES_GLOB='/cursor/stores/*'
BRAIN_EXPORT_MIN_INTERVAL_MIN=55 # export at most once per hour
BRAIN_MAX_FILE_MB=256            # larger files in copied stores are listed in INDEX.md but not copied

# --- verification -----------------------------------------------------------------------------
CHECK_SUBSET="5%"                # daily `restic check --read-data-subset`
TEST_RESTORE_PATHS=(/home/box/agent-data /home/box/sand-data)  # always part of the test-restore sample (if present)
TEST_RESTORE_RANDOM_FILES=25     # plus this many random files (< 64 MB)
TEST_RESTORE_WEEKDAY=0           # weekly test restore (real restore of a sample into a private dir + SHA-256 compare): 0=Sunday..6, "" = off
TEST_RESTORE_AT="02:20"          # ...at this time (HH:MM in $TZ); keep it away from DAILY_CHECK_AT
DRIVE_REPORT=1                   # after each hourly backup upload a small latest-backup-report.txt next to the restic folder (parent of GB_FOLDER); 0 = off

# --- alerts ---------------------------------------------------------------------------------------
ALERT_DEDUPE_HOURS=24            # the same alert text is recorded/sent once per incident; a new incident starts after status.sh --ack or after this many hours
ALERT_HOOK=""                    # off by default. Command run on every NEW alert with the text on stdin and in $GB_ALERT_MSG,
                                 # e.g. ALERT_HOOK='mail -s "Grok Box alert" you@example.com'  (examples: docs/health-and-alerts.md)
ALERT_HOOK_TIMEOUT=60            # seconds before a hung hook is killed; hook failures are logged, never fatal

# --- expected bots (keep real names only in your local config.env, never in the public repo) -------
EXPECTED_BOTS=()                 # bots that must appear in every server-side export (names or agent ids), e.g. ("GrokBox-Main" "GrokBox-Assist")
EXPORT_MISSED_HOURS=26           # integer hours; alert when no active bot has a recent export check; 0 disables
EXPECTED_BOTS_MAX_HOURS=26       # a listed bot whose last export check is older than this counts as missing (alert, doctor.sh)
EXPECTED_BOTS_GRACE_MIN=60       # an incomplete export checked less than this many minutes ago is "in progress", not missing
# The merger does not read config.env; scripts that source lib.sh export AGENTS_DIR and DELETED_BOTS_FILE,
# otherwise set them in the environment when calling it.
AGENTS_DIR="${AGENTS_DIR-/home/box/agent-data/agents}" # active-agent profiles; detects unexported replacements
DELETED_BOTS_FILE="/home/box/agent-data/deleted-agents.json" # roster + merger deleted-bot list; "" disables it
RETIRED_BOTS=()                 # optional retired/deleted bot names or agent ids; never reported missing

# --- pinned binaries (install.sh verifies SHA256 against the upstream SHA256SUMS) --------------
PINNED_RESTIC=0.19.1
PINNED_RCLONE=1.75.2
